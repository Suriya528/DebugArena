{
  "name": "debugarena-server",
  "version": "1.0.0",
  "description": "DebugArena Backend Server",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node src/scripts/ensure_linux_jdk.cjs && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.verification.json --noEmit",
    "test": "tsx src/verification/run_verification.ts all",
    "test:critical": "tsx src/verification/run_verification.ts critical",
    "test:judge": "tsx src/verification/run_verification.ts judge",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "clean-demo": "tsx src/scripts/purge_demo_data.ts",
    "clean-all": "tsx src/scripts/purge_demo_data.ts --all"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.0",
    "puppeteer-core": "^25.10.0",
    "pyodide": "^314.0.6",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {}
}
