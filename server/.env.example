# DebugArena Server Configuration Example

PORT=5000
JWT_SECRET=debugarena-super-secure-jwt-secret-key-2026

# MONGODB_URI: Leave blank for zero-config embedded MongoDB (mongodb-memory-server)
# Or provide your external MongoDB connection URI:
# MONGODB_URI=mongodb://localhost:27017/debugarena
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/debugarena
