# ==========================================
# DebugArena Server Configuration (Example)
# ==========================================

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Allowed Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Cryptographic JWT Secret Key (Minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_32_char_secret_key

# ==========================================
# Google OAuth 2.0 Configuration
# ==========================================
# Obtain your Client ID & Secret from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# Database & External Services
# ==========================================
# MongoDB Connection String (Leave empty for ephemeral in-memory MongoDB in dev)
MONGODB_URI=mongodb://localhost:27017/debugarena

# Code Execution Sandbox (Piston API endpoint)
PISTON_URL=https://emkc.org/api/v2/piston

# ==========================================
# Email / SMTP Service (Optional)
# ==========================================
# If configured, DebugArena sends real transactional email notices.
# If left empty, security notices gracefully log to the server console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="DebugArena Security" <no-reply@debugarena.com>
