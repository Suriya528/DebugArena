{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/scripts/browser_verify.ts",
    "src/scripts/verify_all.ts",
    "src/scripts/verify_*.ts",
    "src/scripts/capture_*.ts"
  ]
}
